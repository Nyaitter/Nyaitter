# ==============================================================================
# Nyaitter サーバー基本設定ファイル (.env)
# このファイルをコピーして .env という名前に変更して使います。
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. サーバーの基本設定
# ------------------------------------------------------------------------------
# サーバーが使うポート番号（通常は 3000 のままで使えます）
PORT=3000

# Discord や SNS に投稿リンクを貼ったときに、投稿内容や画像を表示させるポート番号
# （通常は上の PORT と同じ番号にします）
POST_SHARE_PORT=3000

# ------------------------------------------------------------------------------
# 2. データの保存先（データベース）
# ------------------------------------------------------------------------------
# 保存先の種類: 'memory' (再起動で消えるテスト用), 'postgres' (本番用)
DB_ADAPTER=postgres

# PostgreSQL の接続情報（DB_ADAPTER=postgres の場合に入力します）
DATABASE_URL=postgresql://ユーザー名:パスワード@ホスト名:5432/データベース名?sslmode=require

# ------------------------------------------------------------------------------
# 3. 画像やファイルの保存先
# ------------------------------------------------------------------------------
# 保存先の種類: 'local' (サーバー内に保存), 'r2' (Cloudflare R2 に保存)
STORAGE_ADAPTER=local

# 1人あたりの画像保存上限（メガバイト単位、例: 512 は 512MB）
STORAGE_USER_QUOTA_MB=512

# ------------------------------------------------------------------------------
# 4. ログイン方法の設定 (true で使う / false で使わない)
# ------------------------------------------------------------------------------
# Scratch アカウントでのログイン
AUTH_METHOD_SCRATCH_ENABLED=true

# パスキー（指紋認証・顔認証など）でのログイン
AUTH_METHOD_PASSKEY_ENABLED=true

# メールアドレス認証でのログイン
AUTH_METHOD_EMAIL_ENABLED=false

# ------------------------------------------------------------------------------
# 5. AI による不適切な投稿の自動チェック（Google Gemini）
# ------------------------------------------------------------------------------
# Google AI Studio で取得した API キーを入力すると自動判定が使えます
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
GEMINI_MOD_PROMPT=基本的には緩めに判断してください。過度に不適切な場合のみ対応するようにしてください。
