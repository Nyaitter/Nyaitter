# Nyaitter サーバーの環境変数
# ローカル開発では、このファイルを server/.env にコピーして使用します。
# server/.env は絶対にGitへ登録しないでください。
# 本番用の値は、ホスティングサービスのシークレット管理機能で設定します。

# -----------------------------------------------------------------------------
# 実行環境
# -----------------------------------------------------------------------------
PORT=3000
NODE_ENV=development

# 信頼できるリバースプロキシの背後で動かす場合だけ有効にします。
# TRUST_PROXY=true
# LOG_LEVEL=info
# ALLOWED_ORIGINS=https://nyaitter.example

# -----------------------------------------------------------------------------
# 開発用認証
# -----------------------------------------------------------------------------
# Scratchコメント認証を省略する設定です。ローカル開発時だけ使用してください。
# NODE_ENV=production で DEV_BYPASS_AUTH=true を設定すると、起動時に拒否されます。
DEV_BYPASS_AUTH=false

# -----------------------------------------------------------------------------
# データベース・ストレージアダプター
# -----------------------------------------------------------------------------
# ローカル開発時の既定値です。InMemoryのデータはサーバー再起動時に失われます。
DB_ADAPTER=memory
STORAGE_ADAPTER=local

# PostgreSQL（DB_ADAPTER=postgres）
# DATABASE_URL=postgres://nyaitter:password@localhost:5432/nyaitter?sslmode=disable

# 認証済みプロキシWorker経由のCloudflare D1（DB_ADAPTER=d1）
# D1_WORKER_URL=https://nyaitter-d1-proxy.<あなたのサブドメイン>.workers.dev
# D1_WORKER_TOKEN=<WorkerのAUTH_TOKENシークレットと同じ値>
# D1_REQUEST_TIMEOUT_MS=10000
# D1_RETRY_ATTEMPTS=1
# D1_RETRY_BASE_DELAY_MS=120
# D1_READ_CACHE_SECONDS=0
# D1_BATCH_MAX_ITEMS=100

# Cloudflare R2（STORAGE_ADAPTER=r2 または cloudflare-r2）
# R2_ACCOUNT_ID=<CloudflareアカウントID>
# R2_BUCKET=nyaitter-uploads
# R2_ACCESS_KEY_ID=<S3 APIのAccess Key ID>
# R2_SECRET_ACCESS_KEY=<S3 APIのSecret Access Key>
# R2_PUBLIC_DOMAIN=https://media.example.com
# R2_CACHE_CONTROL=public, max-age=31536000, immutable
# R2_SIGNED_URL_CACHE_SECONDS=300
# R2_RETRY_ATTEMPTS=2
# R2_RETRY_BASE_DELAY_MS=120
# R2_DELETE_CONCURRENCY=8

# -----------------------------------------------------------------------------
# セッション・ログイン保護
# -----------------------------------------------------------------------------
# 記憶済みアカウントCookieの改ざん検知に使う署名鍵です。本番では十分に長く、
# 再起動後も変わらないランダム値を設定してください。未設定時は再起動のたびに
# 記憶済みアカウントが解除されます。
# MULTI_ACCOUNT_COOKIE_SECRET=<十分に長いランダムなシークレット>

# 未知のIPからのログイン確認で、信頼IPを比較するためのHMAC鍵です。未設定時は
# MULTI_ACCOUNT_COOKIE_SECRET を使用します。本番では、信頼IP情報を安全に維持するため
# 別の固定ランダム値を設定してください。
# LOGIN_SECURITY_HMAC_SECRET=<別の十分に長いランダムなシークレット>

# ログイン画面向けCloudflare Turnstile
# TURNSTILE_SECRET_KEY=0x...
# TURNSTILE_SITE_KEY=0x...

# -----------------------------------------------------------------------------
# Web Push / VAPID
# -----------------------------------------------------------------------------
# 鍵ペアは一度だけ生成し、その後も同じ値を継続して使用します。
# 例: npx web-push generate-vapid-keys --json
# VAPID_SUBJECT=mailto:admin@example.com
# VAPID_PUBLIC_KEY=...
# VAPID_PRIVATE_KEY=...

# データベースのパスワード、D1/R2のトークン、Cookie署名鍵、VAPID秘密鍵を
# config.json、ブラウザコード、ログ、バージョン管理対象ファイルへ保存しないでください。

# -----------------------------------------------------------------------------
# Scratchアカウント認証ポリシー
# -----------------------------------------------------------------------------
# 以下の値は server/config.json の auth.scratchVerification より優先されます。
# true / false、1 / 0、yes / no、on / off を指定できます。
# IP制限はIPHubによるVPN・プロキシ・国外IPの判定をまとめて制御します。
# SCRATCH_IP_RESTRICTION_ENABLED=true
# SCRATCH_REJECT_NEW_SCRATCHER=true
# SCRATCH_REJECT_STUDENT_ACCOUNTS=true
# 0を指定すると、有効フォロワー数の条件を無効にします。
# SCRATCH_MIN_QUALIFIED_FOLLOWERS=25

# -----------------------------------------------------------------------------
# 認証レート制限
# -----------------------------------------------------------------------------
# ログイン許可待機の状態確認を含む認証リクエストの上限です。
# 既定値は60秒あたり120件です。必要な場合だけ環境ごとに調整してください。
# RATE_LIMIT_AUTH_WINDOW_MS=60000
# RATE_LIMIT_AUTH_MAX=120
