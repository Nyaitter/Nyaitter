# ==============================================================================
# Nyaitter Server Configuration (.env.example)
# ==============================================================================
# このファイルを server/.env にコピーして、環境に合わせて必要な値を設定してください。
# コピー例: cp server/.env.example server/.env

# ------------------------------------------------------------------------------
# 1. サーバー基本設定
# ------------------------------------------------------------------------------
PORT=3000
NODE_ENV=development
TRUST_PROXY=false
# 本番環境では公開URL（https://...）を指定してください
PUBLIC_URL=http://localhost:3000
SERVER_DOMAIN=localhost
LOG_LEVEL=info

# ------------------------------------------------------------------------------
# 2. API & クライアント設定
# ------------------------------------------------------------------------------
NYAITTER_API_ENDPOINT=/server
NYAITTER_CLIENT_REPOSITORY=Nyaitter/Client
# サーバー経由でユーザーファイルを配信する場合（page/config.js の userFileEndpoint と一致させる）
NYAITTER_USER_FILES_ENDPOINT=/uploads
# NYAITTER_USER_FILES_PORT=

# ------------------------------------------------------------------------------
# 3. CORS (クロスオリジン設定)
# ------------------------------------------------------------------------------
NYAITTER_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
NYAITTER_CORS_CREDENTIALS=true

# ------------------------------------------------------------------------------
# 4. データベース設定
# ------------------------------------------------------------------------------
# memory (開発用インメモリ) / postgres (PostgreSQL) / d1 (Cloudflare D1)
DB_ADAPTER=memory

# PostgreSQL を利用する場合:
# DATABASE_URL=postgres://user:password@localhost:5432/nyaitter
# POSTGRES_SSL_CA=
# POSTGRES_POOL_SIZE=10
# POSTGRES_POOL_MIN=2

# Cloudflare D1 (Proxy Worker) を利用する場合:
# D1_WORKER_URL=https://your-d1-proxy.workers.dev
# D1_WORKER_TOKEN=your-d1-proxy-secret-token

# ------------------------------------------------------------------------------
# 5. ストレージ設定 (画像・メディア)
# ------------------------------------------------------------------------------
# local (ローカルファイルシステム: ./uploads) / r2 (Cloudflare R2)
STORAGE_ADAPTER=local
STORAGE_USER_QUOTA_MB=1024

# Cloudflare R2 を利用する場合:
# R2_ACCOUNT_ID=your-cloudflare-account-id
# R2_BUCKET=your-bucket-name
# R2_ACCESS_KEY_ID=your-r2-access-key-id
# R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
# R2_CACHE_CONTROL=public, max-age=31536000, immutable

# ------------------------------------------------------------------------------
# 6. 認証プロバイダー設定
# ------------------------------------------------------------------------------

# --- 6-1. Scratch 認証 ---
AUTH_METHOD_SCRATCH_ENABLED=true
# 新規アカウント登録を許可するか（falseの場合、既存ユーザーのみログイン可能）
AUTH_METHOD_SCRATCH_ALLOW_SIGNUP=true
SCRATCH_VERIFICATION_PROJECT_ID=1239738451
SCRATCH_IP_RESTRICTION_ENABLED=true
SCRATCH_REJECT_NEW_SCRATCHER=true
SCRATCH_REJECT_STUDENT_ACCOUNTS=true
SCRATCH_MIN_QUALIFIED_FOLLOWERS=25

# --- 6-2. パスキー認証 (WebAuthn / 生体認証) ---
AUTH_METHOD_PASSKEY_ENABLED=true
AUTH_METHOD_PASSKEY_ALLOW_SIGNUP=true
AUTH_PASSKEY_RP_NAME=Nyaitter
# 独自ドメイン運用の場合はドメイン名を指定（例: nyaitter.example.com）
AUTH_PASSKEY_RP_ID=localhost
# AUTH_PASSKEY_ORIGIN=http://localhost:3000

# --- 6-3. メールアドレス認証 (ワンタイムコード) ---
AUTH_METHOD_EMAIL_ENABLED=true
AUTH_METHOD_EMAIL_ALLOW_SIGNUP=true
AUTH_EMAIL_CODE_EXPIRY_MINUTES=10
AUTH_EMAIL_CODE_LENGTH=6

# --- 6-4. NyaitterAuth (他サーバー連携ログイン) ---
AUTH_METHOD_NYAITTER_AUTH_ENABLED=true
AUTH_METHOD_NYAITTER_AUTH_ALLOW_SIGNUP=true

# [メール送信パターンA: 組み込みメールサーバー (外部サービス不要)]
# AUTH_EMAIL_EMBEDDED_SERVER_ENABLED=true
# EMBEDDED_MAIL_SERVER_PORT=2525
# EMBEDDED_MAIL_SERVER_HOST=0.0.0.0
# EMBEDDED_MAIL_DIRECT_DELIVERY_ENABLED=true
# EMBEDDED_MAIL_HOSTNAME=mail.example.com

# [メール送信パターンB: 外部SMTPサーバー (Gmail / SendGrid / Resend等)]
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=user@example.com
# SMTP_PASS=your-smtp-password
# SMTP_FROM=noreply@example.com

# ------------------------------------------------------------------------------
# 7. ボット対策 (Cloudflare Turnstile)
# ------------------------------------------------------------------------------
# TURNSTILE_SECRET_KEY=0x4AAAAAA...
# TURNSTILE_SITE_KEY=0x4AAAAAA...

# ------------------------------------------------------------------------------
# 8. Web Push 通知 (VAPID)
# ------------------------------------------------------------------------------
# VAPID_SUBJECT=mailto:admin@example.com
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=

# ------------------------------------------------------------------------------
# 9. AI 自動モデレーション (Google Gemini)
# ------------------------------------------------------------------------------
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-1.5-flash
# GEMINI_MOD_PROMPT=
# GEMINI_MOD_MAX_IMAGES=0
# GEMINI_MOD_MAX_PENDING_JOBS=500

# ------------------------------------------------------------------------------
# 10. DM & 暗号化設定
# ------------------------------------------------------------------------------
DM_E2E_ENABLED=false

# ------------------------------------------------------------------------------
# 11. 利用規約・コミュニティルール (NyarkDown形式)
# ------------------------------------------------------------------------------
RULES_FILE_PATH=rule.nd

