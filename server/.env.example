# Nyaitter Server Environment Variables
# Copy this file to .env and fill in real values. Never commit .env

PORT=3000
NODE_ENV=development

# === アダプター設定（将来的に切り替え可能） ===
# 現在は InMemoryAdapter（開発用）がデフォルト
DB_ADAPTER=memory

# 将来的にローカルストレージやR2などに対応
STORAGE_ADAPTER=local

# Optional: for future custom JWT sessions
# JWT_SECRET=change_me_to_a_long_random_string

# 複数アカウント切替（HTTPOnly Cookie内の記憶済みセッション一覧を改ざん検知する署名鍵）
# 本番では必ず十分に長いランダム値を設定してください。未設定時は再起動ごとに記憶済みアカウントが解除されます。
# MULTI_ACCOUNT_COOKIE_SECRET=generate_a_long_random_secret_and_keep_it_private

# 未知IPログイン保護のIP比較用HMAC鍵。本番では十分に長いランダム値を必ず固定してください。
# 未設定時はMULTI_ACCOUNT_COOKIE_SECRETを使用し、両方未設定の開発環境では再起動ごとに信頼IPがリセットされます。
# LOGIN_SECURITY_HMAC_SECRET=generate_a_different_long_random_secret_and_keep_it_private

# Scratch認証のバイパス（開発用・極めて危険）
# DEV_BYPASS_AUTH=false
#   ⚠️  本番 (NODE_ENV=production) では自動的に起動拒否されます。
#   ⚠️  絶対に公開サーバーで true にしないでください。認証が完全に無効化されます。

STORAGE_ADAPTER=local

# Cloudflare Turnstile（ログイン画面のロボットチェック用）
# https://developers.cloudflare.com/turnstile/get-started/
# TURNSTILE_SECRET_KEY=0x...
# TURNSTILE_SITE_KEY=0x...   （フロントエンド側で使用）

# 開発用設定
# DEV_BYPASS_AUTH=true   # Scratchコメント検証をスキップ（開発時のみ・ローカル限定）

# ------------------------------------------------------------------
# ほとんどの設定は server/config.json に移動しました。
# 重要な値（PORT, ALLOWED_ORIGINS, DB_ADAPTER など）は環境変数で上書き可能です。
#
# 追加のシステム系環境変数:
#   TRUST_PROXY=true          # リバースプロキシの後ろで動かす場合
#   LOG_LEVEL=debug           # logging.level を上書き
# ------------------------------------------------------------------

# Web Push / VAPID（設定画面のプッシュ通知を有効化する場合に必須）
# 1組の鍵を一度だけ生成し、公開鍵・秘密鍵を安定して保持してください。
# 例: npx web-push generate-vapid-keys --json
# VAPID_SUBJECT=mailto:admin@example.com
# VAPID_PUBLIC_KEY=...
# VAPID_PRIVATE_KEY=...
# 秘密鍵は絶対にブラウザ・config.json・Gitへ公開しないでください。

# Cloudflare R2（STORAGE_ADAPTER=r2 または cloudflare-r2 を使用する場合）
# R2_ACCOUNT_ID=...
# R2_BUCKET=...
# R2_ACCESS_KEY_ID=...
# R2_SECRET_ACCESS_KEY=...
# R2_PUBLIC_DOMAIN=https://assets.example.com
# ランダムなオブジェクトキーへ付けるCDN/ブラウザキャッシュ制御（任意）
# R2_CACHE_CONTROL=public, max-age=31536000, immutable
# 非公開バケットでの同一署名URL生成を短時間だけ再利用する秒数（任意）
# R2_SIGNED_URL_CACHE_SECONDS=300
# 一時的なR2通信障害に対する再試行回数と基準遅延ミリ秒（任意）
# R2_RETRY_ATTEMPTS=2
# R2_RETRY_BASE_DELAY_MS=120
# R2_DELETE_CONCURRENCY=8  # DeleteObjectを同時に実行する最大数（1〜32）

# Cloudflare D1（Node.jsサーバーからは認証済みWorkerプロキシを経由）
# DB_ADAPTER=d1
# D1_WORKER_URL=https://d1-proxy.example.workers.dev
# D1_WORKER_TOKEN=...  # Workerのシークレットと一致させる。リポジトリへ保存しないこと。
# D1_REQUEST_TIMEOUT_MS=10000
# D1_RETRY_ATTEMPTS=1         # 読取操作だけが一時障害時に再試行される
# D1_RETRY_BASE_DELAY_MS=120
# D1_READ_CACHE_SECONDS=0     # 0は無効。短時間TTL（最大60秒）の読取キャッシュ
# D1_BATCH_MAX_ITEMS=100      # 一括ユーザー・投稿・集計取得の上限（1〜500）
