# Nyaitter サーバーの環境変数の例
# このファイルを server/.env にコピーして使います。
# server/.env は秘密情報を含むため、Gitへ追加しないでください。

# -----------------------------------------------------------------------------
# 基本
# -----------------------------------------------------------------------------
PORT=3000
NODE_ENV=development
# LOG_LEVEL=info

# REST APIの公開エンドポイントです。既定値は /server です。
# 同じRESTルートは <endpoint>/posts と <endpoint>/api/posts の両方で利用できます。
# NYAITTER_API_ENDPOINT=/server

# ユーザーファイルをServerから配信する公開パスです。未設定の場合、Serverはユーザーファイルを配信しません。
# R2の公開ドメインから直接配信する場合は、Server側では未設定のままにします。
# NYAITTER_USER_FILES_ENDPOINT=/uploads
# 専用ポートを指定すると、ユーザーファイルだけをそのポートから配信します。
# 未設定の場合は、上記エンドポイントを通常のServerポートから配信します。
# NYAITTER_USER_FILES_PORT=3001

# NyaitterClientの同期先です。未指定時は server/config.json の client.repository、
# それも未指定時は Nyaitter/Client を使用します。
# NYAITTER_CLIENT_REPOSITORY=Nyaitter/Client

# 信頼できるリバースプロキシの背後で動かす場合だけ true にします。
# TRUST_PROXY=true

# CORSで許可するClientのオリジンをカンマ区切りで指定します。
# URLのパス、クエリ、フラグメントは指定できません。未設定時はconfig.jsonのcors.allowedOriginsを使用します。
# NYAITTER_CORS_ALLOWED_ORIGINS=https://client.example.com,https://admin.example.com
# Cookieを含む別オリジンのClient要求を許可する場合だけtrueにします。
# trueにする場合は、上で信頼するClientのオリジンを必ず明示指定してください。
# NYAITTER_CORS_CREDENTIALS=true

# -----------------------------------------------------------------------------
# 入力・取得件数の制限
# -----------------------------------------------------------------------------
# 整数の範囲は 10（ちょうど）、10..（以上）、..10（以下）、10..15（範囲）で指定できます。
# NYAITTER_LIMIT_POST_CONTENT_LENGTH=..1000
# NYAITTER_LIMIT_DM_CONTENT_LENGTH=..2000
# NYAITTER_LIMIT_USER_NAME_LENGTH=1..50
# NYAITTER_LIMIT_PROFILE_BIO_LENGTH=..500
# NYAITTER_LIMIT_SCRATCH_USERNAME_LENGTH=3..20
# NYAITTER_LIMIT_MAX_FILE_UPLOAD_SIZE_MB=5
# NYAITTER_LIMIT_FILE_DELETE_BATCH_SIZE=1000
# NYAITTER_LIMIT_POST_BATCH_SIZE=100
# NYAITTER_LIMIT_USER_SEARCH_PAGE_SIZE=1..100
# NYAITTER_LIMIT_DM_MESSAGES_PAGE_SIZE=1..100

# -----------------------------------------------------------------------------
# レート制限
# -----------------------------------------------------------------------------
# 時間は 10min、10s15m、15m10s、1000ms の形式で指定できます。
# 各MAXはその時間内に許可するリクエスト数です。
# NYAITTER_RATE_LIMIT_GENERAL_WINDOW=1min
# NYAITTER_RATE_LIMIT_GENERAL_MAX=1000
# NYAITTER_RATE_LIMIT_AUTH_WINDOW=1min
# NYAITTER_RATE_LIMIT_AUTH_MAX=120
# NYAITTER_RATE_LIMIT_POST_WRITE_WINDOW=1min
# NYAITTER_RATE_LIMIT_POST_WRITE_MAX=30
# NYAITTER_RATE_LIMIT_PROFILE_UPDATE_WINDOW=1min
# NYAITTER_RATE_LIMIT_PROFILE_UPDATE_MAX=20
# NYAITTER_RATE_LIMIT_DM_SEND_WINDOW=1min
# NYAITTER_RATE_LIMIT_DM_SEND_MAX=60
# NYAITTER_RATE_LIMIT_UPLOAD_WINDOW=1min
# NYAITTER_RATE_LIMIT_UPLOAD_MAX=30
# NYAITTER_RATE_LIMIT_NOTIFICATION_WINDOW=1min
# NYAITTER_RATE_LIMIT_NOTIFICATION_MAX=60
# NYAITTER_RATE_LIMIT_REPORT_CREATE_WINDOW=1min
# NYAITTER_RATE_LIMIT_REPORT_CREATE_MAX=10
# NYAITTER_RATE_LIMIT_REPORT_ACTION_WINDOW=1min
# NYAITTER_RATE_LIMIT_REPORT_ACTION_MAX=30
# NYAITTER_RATE_LIMIT_VERIFICATION_APPLICATION_WINDOW=1min
# NYAITTER_RATE_LIMIT_VERIFICATION_APPLICATION_MAX=5

# -----------------------------------------------------------------------------
# 開発用認証
# -----------------------------------------------------------------------------
# Scratch認証を省略する開発専用設定です。公開サーバーでは絶対にtrueにしないでください。
DEV_BYPASS_AUTH=false

# -----------------------------------------------------------------------------
# DM暗号化
# -----------------------------------------------------------------------------
# 複数デバイスでのDM利用を優先するため、既定では無効です。
# 再有効化には true の指定に加え、クライアント側実装の再有効化が必要です。
DM_E2E_ENABLED=false

# -----------------------------------------------------------------------------
# DBとファイル保存先
# -----------------------------------------------------------------------------
# ローカル開発の初期設定です。memoryのデータは再起動で消えます。
DB_ADAPTER=memory
STORAGE_ADAPTER=local

# 1ユーザー当たりの保存上限です。単位はMBです。初期値は1024 MB（1 GB）です。
# STORAGE_USER_QUOTA_MB=1024

# PostgreSQLを使う場合（DB_ADAPTER=postgres）
# DATABASE_URL=postgres://nyaitter:password@localhost:5432/nyaitter?sslmode=disable

# CockroachDB Cloudを使う場合（DB_ADAPTER=cockroach）
# Cloud Consoleの「General connection string」をそのまま設定します。
# COCKROACH_DATABASE_URL=postgresql://user:password@cluster.cockroachlabs.cloud:26257/defaultdb?sslmode=verify-full
# CockroachDB Advancedなどで専用CAが必要な場合だけ、PEM本文を指定します。
# COCKROACH_SSL_CA=
# COCKROACH_POOL_SIZE=10
# COCKROACH_TRANSACTION_RETRIES=5
# COCKROACH_RETRY_BASE_DELAY_MS=50

# Cloudflare D1を使う場合（DB_ADAPTER=d1）
# D1_WORKER_URL=https://nyaitter-d1-proxy.example.workers.dev
# D1_WORKER_TOKEN=<WorkerのAUTH_TOKENと同じ値>
# D1_REQUEST_TIMEOUT_MS=10000
# D1_RETRY_ATTEMPTS=1
# D1_RETRY_BASE_DELAY_MS=120
# D1_READ_CACHE_SECONDS=0
# D1_BATCH_MAX_ITEMS=100

# Cloudflare R2を使う場合（STORAGE_ADAPTER=r2）
# R2_ACCOUNT_ID=<CloudflareのアカウントID>
# R2_BUCKET=nyaitter-uploads
# R2_ACCESS_KEY_ID=<S3 API Access Key ID>
# R2_SECRET_ACCESS_KEY=<S3 API Secret Access Key>
# R2_PUBLIC_DOMAIN=https://media.example.com
# R2_CACHE_CONTROL=public, max-age=31536000, immutable
# R2_SIGNED_URL_CACHE_SECONDS=300
# R2_RETRY_ATTEMPTS=2
# R2_RETRY_BASE_DELAY_MS=120
# R2_DELETE_CONCURRENCY=8

# -----------------------------------------------------------------------------
# ログイン保護
# -----------------------------------------------------------------------------
# 本番では長いランダム値を設定し、再起動しても変更しないでください。
# MULTI_ACCOUNT_COOKIE_SECRET=<長いランダム文字列>
# LOGIN_SECURITY_HMAC_SECRET=<別の長いランダム文字列>

# Cloudflare Turnstileを使う場合
# TURNSTILE_SECRET_KEY=0x...
# TURNSTILE_SITE_KEY=0x...

# -----------------------------------------------------------------------------
# Push通知
# -----------------------------------------------------------------------------
# VAPID_SUBJECT=mailto:admin@example.com
# VAPID_PUBLIC_KEY=...
# VAPID_PRIVATE_KEY=...

# -----------------------------------------------------------------------------
# Gemini自動モデレーション
# -----------------------------------------------------------------------------
# 次の3項目をすべて設定した場合だけ有効になります。APIキーはserver/.envでの設定を推奨します。
# config.jsonのgeminiModerationにも設定できます。投稿・編集済みのポストを順番に判定します。
# GEMINI_API_KEY=...
# GEMINI_MODEL=gemini-2.0-flash
# GEMINI_MOD_PROMPT=投稿をコミュニティルールに基づいて判定してください。
# 本文に加えてGeminiへ送る添付画像の最大数です。0は本文だけを判定します。
# GEMINI_MOD_MAX_IMAGES=0

# -----------------------------------------------------------------------------
# Scratch認証ポリシー
# -----------------------------------------------------------------------------
# true / false、1 / 0、yes / no、on / off を指定できます。
# SCRATCH_IP_RESTRICTION_ENABLED=true
# SCRATCH_REJECT_NEW_SCRATCHER=true
# SCRATCH_REJECT_STUDENT_ACCOUNTS=true
# SCRATCH_MIN_QUALIFIED_FOLLOWERS=25

# -----------------------------------------------------------------------------
# 認証のレート制限
# -----------------------------------------------------------------------------
# RATE_LIMIT_AUTH_WINDOW_MS=60000
# RATE_LIMIT_AUTH_MAX=120
