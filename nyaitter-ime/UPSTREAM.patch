@@ -0,0 +1,15 @@
+'use strict';
+
+// Curated entries layered over the generated Mozc OSS dictionary.
+//
+// The binary dictionary is rebuilt from Mozc, so entries that are missing or
+// whose only Mozc candidate is a rare/pejorative spelling belong here. Costs are
+// relative to the generated dictionary: a negative cost promotes the entry,
+// while a non-negative cost only adds an alternative.
+const SUPPLEMENTS = Object.freeze([
+  // Mozc only has 運痴 for うんち, which is a rare and offensive spelling.
+  { reading: 'うんち', surface: 'うんち', cost: -2000 },
+  { reading: 'うんち', surface: 'ウンチ', cost: 500 }
+]);
+
+module.exports = { SUPPLEMENTS };
