+test('converts hyphenated long-vowel loanwords as one reading', () => {
+  assert.equal(convert('ki-bo-do'), 'キーボード');
+  assert.equal(convert('ki-bo-do wo tsukau'), 'キーボード を 使う');
+  assert.equal(convert('me-ru'), 'メール');
+  assert.equal(convert('ko-hi-'), 'コーヒー');
+});
+
+test('falls back to folded long vowels for doubled-vowel loanwords', () => {
+  assert.equal(convert('kiiboodo'), 'キーボード');
+  assert.equal(convert('suupaa'), 'スーパー');
+  assert.equal(convert('meeru'), 'メール');
+  // Exact Mozc readings still win over the folded fallback.
+  assert.equal(convert('ookii'), '大きい');
+  assert.equal(convert('tooi'), '遠い');
+});
+
+test('keeps hyphenated English words as English', () => {
+  assert.equal(convert('e-mail'), 'e-mail');
+  assert.equal(convert('e-mail wo okuru'), 'e-mail を 送る');
+  assert.equal(convert('keyboard-shortcut'), 'keyboard-shortcut');
+  assert.equal(convert('boo'), 'boo');
+  assert.equal(convert('book'), 'book');
+});
+
+test('supplemental dictionary promotes common spellings', () => {
+  assert.equal(convert('unchi'), 'うんち');
